GEO_ID = GEOID,
numWorkers = B08130_001E,
numPublicTransit = B08130_016E,
numPT_inCounty = B08130_018E, # Public transit, worked in county
numPT_outCounty = B08130_019E, # Public transit, worked out of county
numPT_outState = B08130_020E, # Public transit, outside of state,
numWFH = B08301_031E, # Worked from home
numBus = B08301_011E, # Bus
numSubway = B08301_012E, # Subway
numTrain = B08301_013E, # Long distant train or commuter rail
numLightrail = B08301_014E, # Light rail or streetcar
numFerry = B08301_015E # Ferry
) %>%
mutate(
County = str_match(NAME, "\\s*([^,]+) County(?=,|$)")[,2],   # Extract county name from NAME
State = str_extract(NAME, "[^,]+$"),   # Extract state from NAME
# Percentages for public transit
pctPublicTransit = round((numPublicTransit / numWorkers) * 100, 2),
pctPublicTransit_noWFH = round((numPublicTransit / (numWorkers - numWFH)) * 100, 2),
pctWorkInCountyPublicTransit = round((numPT_inCounty / numWorkers) * 100, 2),
pctWorkInCountyPublicTransit_noWFH = round((numPT_inCounty / (numWorkers - numWFH)) * 100, 2),
pctWorkOutOfCountyPublicTransit = round((numPT_outCounty / numWorkers) * 100, 2),
pctWorkOutOfCountyPublicTransit_noWFH = round((numPT_outCounty / (numWorkers - numWFH)) * 100, 2),
pctWorkOutOfStatePublicTransit = round((numPT_outState / numWorkers) * 100, 2),
pctWorkOutOfStatePublicTransit_noWFH = round((numPT_outState / (numWorkers - numWFH)) * 100, 2),
# Flags for decision criteria
flag_above_7_OverallAndInCounty = pctPublicTransit >= 7 & pctWorkInCountyPublicTransit >= 7,
flag_above_7_OverallAndInCounty_noWFH = pctPublicTransit_noWFH >= 7 & pctWorkInCountyPublicTransit_noWFH >= 7,
flag_above_7_EitherOverallORInCounty = pctPublicTransit >= 7 | pctWorkInCountyPublicTransit >= 7,
flag_above_7_EitherOverallORInCounty_noWFH = pctPublicTransit_noWFH >= 7 | pctWorkInCountyPublicTransit_noWFH >= 7,
flag_near_threshold = (pctPublicTransit >= 6.5 & pctPublicTransit < 7) |
(pctWorkInCountyPublicTransit >= 6.5 & pctWorkInCountyPublicTransit < 7),
flag_near_threshold_noWFH = (pctPublicTransit_noWFH >= 6.5 & pctPublicTransit_noWFH < 7) |
(pctWorkInCountyPublicTransit_noWFH >= 6.5 & pctWorkInCountyPublicTransit_noWFH < 7),
# Mode-specific percentages
pctBus = round((numBus / numPublicTransit) * 100, 2),
pctSubway = round((numSubway / numPublicTransit) * 100, 2),
pctTrain = round((numTrain / numPublicTransit) * 100, 2),
pctLightrail = round((numLightrail / numPublicTransit) * 100, 2),
pctFerry = round((numFerry / numPublicTransit) * 100, 2)
)
