moePT_inCounty = B08130_018M, # Public transit, worked in county
numPT_outCounty = B08130_019E, # Public transit, worked out of county
moePT_outCounty = B08130_019M, # Public transit, worked out of county
numPT_outState = B08130_020E, # Public transit, outside of state,
moePT_outState = B08130_020M, # Public transit, outside of state,
numWFH = B08130_031E, # Worked from home
moeWFH = B08130_031M, # Worked from home
numBus = B08301_011E, # Bus
moeBus = B08301_011M, # Bus
numSubway = B08301_012E, # Subway
moeSubway = B08301_012M, # Subway
numTrain = B08301_013E, # Long distant train or commuter rail
moeTrain = B08301_013M, # Long distant train or commuter rail
numLightrail = B08301_014E, # Light rail or streetcar
moeLightrail = B08301_014M, # Light rail or streetcar
numFerry = B08301_015E, # Ferry
moeFerry = B08301_015M # Ferry
) %>%
mutate(
County = str_match(NAME, "\\s*([^,]+) County(?=,|$)")[,2],   # Extract county name from NAME
State = str_extract(NAME, "[^,]+$"),   # Extract state from NAME
# Percentages for public transit
pctPublicTransit = round((numPublicTransit / numWorkers) * 100, 2),
pctPublicTransit_noWFH = round((numPublicTransit / (numWorkers - numWFH)) * 100, 2),
pctWorkInCountyPublicTransit = round((numPT_inCounty / numWorkers) * 100, 2),
pctWorkInCountyPublicTransit_noWFH = round((numPT_inCounty / (numWorkers - numWFH)) * 100, 2),
pctWorkOutOfCountyPublicTransit = round((numPT_outCounty / numWorkers) * 100, 2),
pctWorkOutOfCountyPublicTransit_noWFH = round((numPT_outCounty / (numWorkers - numWFH)) * 100, 2),
pctWorkOutOfStatePublicTransit = round((numPT_outState / numWorkers) * 100, 2),
pctWorkOutOfStatePublicTransit_noWFH = round((numPT_outState / (numWorkers - numWFH)) * 100, 2),
# Flags for decision criteria
flag_above_7_OverallAndInCounty = pctPublicTransit >= 7 & pctWorkInCountyPublicTransit >= 7,
flag_above_7_OverallAndInCounty_noWFH = pctPublicTransit_noWFH >= 7 & pctWorkInCountyPublicTransit_noWFH >= 7,
flag_above_7_EitherOverallORInCounty = pctPublicTransit >= 7 | pctWorkInCountyPublicTransit >= 7,
flag_above_7_EitherOverallORInCounty_noWFH = pctPublicTransit_noWFH >= 7 | pctWorkInCountyPublicTransit_noWFH >= 7,
flag_near_threshold = (pctPublicTransit >= 6.5 & pctPublicTransit < 7) |
(pctWorkInCountyPublicTransit >= 6.5 & pctWorkInCountyPublicTransit < 7),
flag_near_threshold_noWFH = (pctPublicTransit_noWFH >= 6.5 & pctPublicTransit_noWFH < 7) |
(pctWorkInCountyPublicTransit_noWFH >= 6.5 & pctWorkInCountyPublicTransit_noWFH < 7),
# Mode-specific percentages
pctBus = round((numBus / numPublicTransit) * 100, 2),
pctSubway = round((numSubway / numPublicTransit) * 100, 2),
pctTrain = round((numTrain / numPublicTransit) * 100, 2),
pctLightrail = round((numLightrail / numPublicTransit) * 100, 2),
pctFerry = round((numFerry / numPublicTransit) * 100, 2),
# Calculate CVs for public transit estimates
cv_numWorkers = calc_cv_from_moe(numWorkers, moeWorkers),
cv_numPublicTransit = calc_cv_from_moe(numPublicTransit, moePublicTransit),
cv_numPT_inCounty = calc_cv_from_moe(numPT_inCounty, moePT_inCounty),
cv_numPT_outCounty = calc_cv_from_moe(numPT_outCounty, moePT_outCounty),
cv_numPT_outState = calc_cv_from_moe(numPT_outState, moePT_outState),
cv_numWFH = calc_cv_from_moe(numWFH, moeWFH),
cv_numBus = calc_cv_from_moe(numBus, moeBus),
cv_numSubway = calc_cv_from_moe(numSubway, moeSubway),
cv_numTrain = calc_cv_from_moe(numTrain, moeTrain),
cv_numLightrail = calc_cv_from_moe(numLightrail, moeLightrail),
cv_numFerry = calc_cv_from_moe(numFerry, moeFerry),
# Flags for unreliable estimates based on CV
flag_unreliable_numWorkers = flag_unreliable_cv(cv_numWorkers),
flag_unreliable_numPublicTransit = flag_unreliable_cv(cv_numPublicTransit),
flag_unreliable_numPT_inCounty = flag_unreliable_cv(cv_numPT_inCounty),
flag_unreliable_numPT_outCounty = flag_unreliable_cv(cv_numPT_outCounty),
flag_unreliable_numPT_outState = flag_unreliable_cv(cv_numPT_outState),
flag_unreliable_numWFH = flag_unreliable_cv(cv_numWFH),
flag_unreliable_numBus = flag_unreliable_cv(cv_numBus),
flag_unreliable_numSubway = flag_unreliable_cv(cv_numSubway),
flag_unreliable_numTrain = flag_unreliable_cv(cv_numTrain),
flag_unreliable_numLightrail = flag_unreliable_cv(cv_numLightrail),
flag_unreliable_numFerry = flag_unreliable_cv(cv_numFerry)
)
table(data$flag_unreliable_numWorkers)
table(data$flag_unreliable_numPublicTransit)
table(data$flag_unreliable_numPT_inCounty)
table(data$flag_unreliable_numPT_outCounty)
# ----------------------------------------------------------------------
# Project Name: save_google_sheets_to_csv
# Purpose: Downloads structured data from a shared Google Sheet
#          and saves it into clean, year-specific CSVs for use in R workflows.
# Author: Lisa Manzer
# Date Created: 05/15/2025
# Last Modified: 05/15/2025
# ----------------------------------------------------------------------
# 1. Setup ----------------------------------------------------------------
# # Install necessary packages if not already installed
# if (!requireNamespace("pak", quietly = TRUE)) install.packages("pak")
# pak::pak(c("sssUtils", "googlesheets4", "dplyr", "readr"))
#
# # Load libraries
library(sssUtils)
library(googlesheets4)
library(dplyr)
library(readr)
#
# # Set base path for saving files
base_path <- get_base_path()
# Authenticate with Google
gs4_auth()
# Google Sheet URL (must be shared with your account)
sheet_url <- "https://docs.google.com/spreadsheets/d/1vTPFw3fZi3dqdQ1UV-pCj9RaiNeh3eiS9D0iUfWyO6k"
# Tax year to save under
tax_year <- 2026
# Define mapping from tab names to output filenames
tax_sheets <- list(
fed_income_brackets    = "tax_fed_income_brackets.csv",
fed_sd                 = "tax_fed_sd.csv",
fed_payroll            = "tax_fed_payroll.csv",
fed_credits            = "tax_fed_credits.csv",
state_income_brackets  = "tax_state_income_brackets.csv",
state_ti_adjustments   = "tax_state_ti_adjustments.csv",
state_credits          = "tax_state_credits.csv",
state_variable_brackets  = "tax_state_variable_brackets.csv",
state_payroll          = "tax_state_payroll.csv"
)
# Define numeric columns that should be parsed as numbers, including Inf and NA
numeric_columns_by_tab <- list(
fed_income_brackets    = c("upper_limit", "rate"),
fed_sd                 = c("deduction"),
fed_payroll            = c("value"),
fed_credits            = c("value"),
state_income_brackets  = c("upper_limit", "rate"),
state_ti_adjustments   = c("value"),
# state_credits          = c("value", "flag"),
state_variable_brackets  = c("income_max"),
state_payroll          = c("value")
)
# 3. Helpers ----------------------------------------------------------------
# Convert mixed character/numeric columns into real numerics (e.g., "Inf", "NA", "")
parse_numeric_columns <- function(df, numeric_cols) {
parse_special <- function(x) {
case_when(
x %in% c("Inf", "inf") ~ Inf,
x %in% c("NA", "na", "") ~ NA_real_,
TRUE ~ suppressWarnings(as.numeric(x))
)
}
df %>%
mutate(across(all_of(numeric_cols), parse_special))
}
# 4. Output paths ----------------------------------------------------------
fed_path <- file.path(build_processed_data_path(module = "taxes_federal", state = NULL))
fed_path <- file.path(build_data_processed_path(module = "taxes_federal", state = NULL))
state_path <- file.path(build_data_processed_path(module = "taxes_state", state = NULL))
dir.create(fed_path, recursive = TRUE, showWarnings = FALSE)
dir.create(state_path, recursive = TRUE, showWarnings = FALSE)
for (tab in names(tax_sheets)) {
message("Reading tab: ", tab)
# Read the sheet, treating all columns as character to avoid type errors
sheet_data <- read_sheet(sheet_url, sheet = tab, col_types = "c") %>%
mutate(across(everything(), ~ na_if(.x, "")))  # Blank cells → NA
# Convert relevant columns to numeric where applicable
if (tab %in% names(numeric_columns_by_tab)) {
sheet_data <- parse_numeric_columns(sheet_data, numeric_columns_by_tab[[tab]])
}
# Drop empty columns
sheet_data <- sheet_data %>%
select(where(~ !all(is.na(.))))
# Choose save location
out_path <- if (startsWith(tab, "fed_")) fed_path else state_path
out_file <- file.path(out_path, tax_sheets[[tab]])
# Save
write_csv(sheet_data, out_file)
message("Saved: ", normalizePath(out_file))
}
