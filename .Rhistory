z_90 <- 1.645 # 90% confidence interval z-score
cv_threshold <- 0.30 # Coefficient of variation threshold for data reliability
# Helpers
# Calculate coefficient of variation (CV) from ACS estimate + MOE (90% CI)
calc_cv_from_moe <- function(estimate, moe, z = z_90) {
dplyr::case_when(
is.na(estimate) | is.na(moe) ~ NA_real_,
estimate <= 0 ~ NA_real_,
TRUE ~ (moe / z) / estimate
)
}
# Flag unreliable estimates using Census-style threshold
flag_unreliable_cv <- function(cv, threshold = cv_threshold) {
dplyr::case_when(
is.na(cv) ~ NA,                 # keep unknown as NA for auditability
cv > threshold ~ TRUE,          # unreliable
TRUE ~ FALSE                    # reliable
)
}
data <- bind_rows(county_data, municipal_data) %>%
